# ReaTerm decision-model configuration template
#
# Copy this file to .env, edit the values, then EXPORT them in the calling
# shell (see README.md). Python and TypeScript DO NOT load .env automatically.
# The native Rust CLI never uses a model: these settings apply only to the
# Python and TypeScript wrappers and only provide an additional veto.
#
# Required to enable optional model decisions. Leaving this empty disables
# model checks and uses the native Rust allowlist + Landlock + seccomp only.
REATERM_DECISION_MODEL=

# Required when REATERM_DECISION_MODEL is set.
# Do not commit real secrets; .env is ignored by Git.
REATERM_OPENAI_API_KEY=

# Optional custom OpenAI-compatible chat completions API endpoint.
# Leave empty for the official OpenAI default, or set, for example:
# REATERM_OPENAI_BASE_URL=https://your-provider.example/v1
REATERM_OPENAI_BASE_URL=

# Optional path to the trusted, compiled Rust executable if it is not on PATH.
# REATERM_BIN=/absolute/path/to/reaterm

# Existing conventional OpenAI variables are supported as FALLBACKS by the
# wrappers, only when the corresponding REATERM_OPENAI_* setting is unset.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# SECURITY: Enabling model decisions sends command argv (which can include
# sensitive filenames) to the configured provider. Model ALLOW never grants
# operations denied by the native Rust engine; errors/ambiguity veto requests.
